{
  "name": "kvasir-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "types": "cd .. && uv run python -c 'import json; from kvasir.api.app import app; print(json.dumps(app.openapi()))' > web/.tmp-openapi.json && cd web && openapi-typescript .tmp-openapi.json -o src/lib/schema.d.ts && rm .tmp-openapi.json"
  },
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "bits-ui": "2.20.2",
    "marked": "18.1.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "26.6.6",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
