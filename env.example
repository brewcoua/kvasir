# The development environment. `just setup` copies this to .env and fills in the empty secrets.
# Only the `just` recipes that run the service read .env; the tests set their own environment.
# Settings that are not here live in kvasir.db: see settings.dev.example.json.

# Generated by `just setup`. The data directory opens only with the KVASIR_SECRET_KEY it was
# encrypted under, so losing it loses the data.
KVASIR_TOKEN=
KVASIR_SECRET_KEY=
SEARXNG_SECRET=

KVASIR_DATA_DIR=data
KVASIR_HOST=127.0.0.1
KVASIR_PORT=8080
KVASIR_LOG_LEVEL=INFO
KVASIR_LOG_FORMAT=text

# Ollama answers one request at a time by default, so a wide pool only queues. Start Ollama with
# OLLAMA_NUM_PARALLEL set to match for calls to run side by side.
KVASIR_MAX_THREADS=2

KVASIR_PROVIDER_LOCAL_API_BASE=http://localhost:11434/v1
# A second provider takes its name from the variable. A model refers to it as cloud/<model>.
# KVASIR_PROVIDER_CLOUD_API_BASE=https://ollama.com/v1
# KVASIR_PROVIDER_CLOUD_API_KEY=
