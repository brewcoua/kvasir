{
  "name": "kvasir-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "types": "cargo run -q --manifest-path ../../Cargo.toml -p kvasir -- openapi > .tmp-openapi.json && openapi-typescript .tmp-openapi.json -o src/lib/schema.d.ts && rm .tmp-openapi.json"
  },
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "@xyflow/svelte": "1.7.0",
    "bits-ui": "2.20.2",
    "d3-drag": "3.0.0",
    "d3-force": "3.0.0",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "marked": "18.1.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/d3-drag": "3.0.7",
    "@types/d3-force": "3.0.10",
    "@types/d3-selection": "3.0.12",
    "@types/d3-zoom": "3.0.9",
    "@types/node": "26.6.6",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
