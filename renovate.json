{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "lockFileMaintenance": { "enabled": true },
  "packageRules": [
    {
      "description": "Base and tool images are pinned by digest so a rebuild resolves to the same bytes.",
      "matchManagers": ["dockerfile"],
      "pinDigests": true
    }
  ]
}
